<h1 class="sr-only">World History Commons</h1>
<div class="front-page">
  <div class="featured-banner">
    <div class="content-well">{{header}}</div>
  </div>

  {% set data = rows.0['#rows']%}

  <div class="content-well box-wrapper">

    {% for item in data %}

      {% if item['#row']._entity.field_primary_sources.entity.field_image_thumbnail.0 is not null %}
        {% set thumbnail = file_url(item['#row']._entity.field_primary_sources.entity.field_image_thumbnail.0.entity.uri.value) %}
      {% else %}
        {% set thumbnail = file_url(item['#row']._entity.field_image_thumbnail.0.entity.uri.value) %}
      {% endif %}

      <div class="views-row" style="background-image: url({{thumbnail}})">
        <a href="{{path('entity.node.canonical', {'node': item['#row']._entity.nid.value  })}}" class="box-hover">
          <div class="box-info">
            <div class="box-info--title"> {{item['#row']._entity.title.value}}</div>
            <span class="box-info--link">Learn More</span>
          </div>
        </a>
      </div>
    {% endfor %}

  </div>
  
</div>

