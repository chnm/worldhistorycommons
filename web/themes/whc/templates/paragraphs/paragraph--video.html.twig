{% if content.field_youtube_link.0 %}

<div class="content-videos--info">
  
  {% if content.field_youtube_link.0 %}
    <div class="youtube-video">{{content.field_youtube_link}}</div>
  {% endif %}

  {% if content.field_video_clip.0 %}
    <a href="{{file_url(content.field_video_clip.0['#file'].uri.value)}}" class="dl-link">Download Video Clip</a>
  {% endif %}
  
  {% if content.field_video_clip_transcript.0 %}
    <h3>Video Clip Transcripts:</h3>
    {{content.field_video_clip_transcript}}
  {% endif %}

  {% if content.field_video_clip_transcript_down.0 %}
    <a href="{{file_url(content.field_video_clip_transcript_down.0['#file'].uri.value)}}" class="dl-link">Download Clip Transcript</a>
  {% endif %}
</div>

{% endif %}