<div class="content-well">
  <div class="col--2-3">
    <div>
      <a href="{{content.field_url.0['#url'].uri}}" class="content-header review-header">
        <div class="content-header--label">Website Review</div>
        <h1>{{node.label}}</h1>
        <div class="content-header--author">
        {{content.field_website_creator}}
        </div>
      </a>
      {{content.field_website_review}}

      <div class="content-details">
        {% if content.field_credits.0 %}
        <details open>
          <summary><h3>Credits</h3></summary>
          <div class="well--data">{{content.field_credits}}</div>
        </details>
        {% endif %}
      </div>

      <div class="citation">
        <div class="credit">
          <div class="text">Reviewed by {{content.field_website_reviewer.0 | raw}}, {{content.field_website_reviewer_instituti.0 | raw }}</div>
          <div class="link"><strong>Url:</strong> <a href="{{content.field_url.0['#url'].uri}}">{{content.field_url.0['#url'].uri}}</a></div>
        </div>

        <h3>How to Cite This Source</h3>
        <span>"{{node.label}}," in in World History Commons, {{ url('<current>') }} [accessed {{ "now"|date("F j, Y") }}]</span>
      </div>

      <div class="tags">
        <h3>Tags</h3>
        {{content.field_region}}
        {{content.field_subject}}
        {{content.field_time_period}}
      </div>

    </div>

    <div class="pull-quote--sidebar">
      {{content.field_image_thumbnail}}
      <div class="quote">“{{content.field_pull_quote.0 | raw}}”</div>
    </div>
  </div>

</div>
