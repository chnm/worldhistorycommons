{# {{devel_dump()}} #}

<div class="content-header">
  <div class="content-header--label">Primary Source</div>
  <h1>{{node.label}}</h1>
</div>

<div class="two-cols">
  <div>
    <div class="image-wrap">{{content.field_image}}</div>
  </div>
  <div>
    <div class="box-border">
      <h2 class="box-border--title">Annotation</h2>
      {{content.field_annotation}}
    </div>
  </div>
</div>

<div class="content-well">

  <div class="content-meta">{{content.field_source_metadata}}</div>

  <div class="content-details">
    
    {% if content.field_text.0 %}
    <details>
      <summary><h3>Text</h3></summary>
      <div>{{content.field_text}}</div>
    </details>
    {% endif %}

    {% if content.field_transcription.0 %}
    <details>
      <summary><h3>Transcription</h3></summary>
      <div>{{content.field_transcription}}</div>
    </details>
    {% endif %}

    {% if content.field_translation.0 %}
    <details>
      <summary><h3>Translation</h3></summary>
      <div>{{content.field_translation}}</div>
    </details>
    {% endif %}

    {% if content.field_credits.0 %}
    <details open>
      <summary><h3>Credits</h3></summary>
      <div>{{content.field_credits}}</div>
    </details>
    {% endif %}
  <div>


  <div class="citation">
    <h3>How to Cite This Source</h3>
    <span>"{{node.label}}," in in World History Commons, {{ url('<current>') }} [ {{ "now"|date("F j, Y") }} ]</span>
  </div>

  <div class="tags">
    <h3>Tags</h3>
    {{content.field_region}}
    {{content.field_subject}}
    {{content.field_time_period}}
  </div>

</div>