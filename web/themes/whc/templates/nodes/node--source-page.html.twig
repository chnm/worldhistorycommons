<div class="content-header">
  <div class="content-header--label">Primary Source</div>
  <h1>{{node.label}}</h1>
</div>

<div class="two-cols">
  <div>
  {% set type = content.field_type.0['#markup'] %}
  {% if type == 'Audio' %}
    <div aria-label="Audio Icon" class="audio-icon"></div>
    <div class="audio-wrap">
      <div>{{content.field_audio}}</div>
      <a href="{{file_url(content.field_audio.0['#files'].0.file.uri.value)}}">Download Audio</a>
    </div>
  {% endif %}

  {% if type == 'Image' or type == 'Object' %}
    <div class="image-wrap">
      {{content.field_image}}
    </div>
  {% endif %}

  {% if type == 'Text' %}
    {% if content.field_text_file.0['#file'].uri.value is null %}
      <a href="#doc-text" aria-label="View Document" class="doc-icon" id="doc-text-icon"></a>
    {% else %}
      <a href="{{file_url(content.field_text_file.0['#file'].uri.value)}}" aria-label="View Document" class="doc-icon"></a>
    {% endif %}
  {% endif %}

  {% if type == 'Video' %}

    {% if content.field_youtube_video.0 %}
        {{content.field_youtube_video}}
    {% else %}
        {{content.field_video}}
    {% endif %}

  {% endif %}

  </div>
  <div>
    <div class="box-border">
      <h2 class="box-border--title">Annotation</h2>
      {{content.field_annotation}}
    </div>
  </div>
</div>

<div class="content-well">

  <div class="content-meta">{{content.field_source_metadata}}</div>

  <div class="content-details">
    
    {% if content.field_text.0 %}
    <details>
      <summary id="doc-text"><h3>Text</h3></summary>
      <div>{{content.field_text}}</div>
    </details>
    {% endif %}

    {% if content.field_transcription.0 %}
    <details>
      <summary><h3>Transcription</h3></summary>
      <div>{{content.field_transcription}}</div>
    </details>
    {% endif %}

    {% if content.field_translation.0 %}
    <details>
      <summary><h3>Translation</h3></summary>
      <div>{{content.field_translation}}</div>
    </details>
    {% endif %}

    {% if content.field_credits.0 %}
    <details open>
      <summary><h3>Credits</h3></summary>
      <div>{{content.field_credits}}</div>
    </details>
    {% endif %}
  <div>


  <div class="citation">
    <h3>How to Cite This Source</h3>
    <span>"{{node.label}}," in World History Commons, {{ url('<current>') }} [accessed {{ "now"|date("F j, Y") }}]</span>
  </div>

  <div class="tags">
    <h3>Tags</h3>
    {{content.field_region}}
    {{content.field_subject}}
    {{content.field_time_period}}
  </div>

</div>