{{devel_dump()}}

<div class="content-header">
  <div class="content-header--label">Methods</div>
  <h1>{{node.label}}</h1>
  <div class="content-header--author">
    {{content.field_author}}
  </div>
</div>

<div class="two-cols">
  <div>
  
  </div>
  <div>
    <div class="box-border">
      <h2 class="box-border--title">Overview</h2>
      {{content.field_overview}}
    </div>
  </div>
</div>

<div class="content-well">

  <div class="content-details">
    
    {% if content.field_essay.0 %}
    <details>
      <summary><h3>Eassy</h3></summary>
      <div>{{content.field_essay}}</div>
    </details>
    {% endif %}

    {% if content.field_sample_analysis.0 %}
    <details>
      <summary><h3>Analysis</h3></summary>
      <div>{{content.field_sample_analysis}}</div>
    </details>
    {% endif %}

    {% if content.field_bibliography.0 %}
    <details>
      <summary><h3>Bibliography</h3></summary>
      <div>{{content.field_bibliography}}</div>
    </details>
    {% endif %}

    {% if content.field_credits.0 %}
    <details open>
      <summary><h3>Credits</h3></summary>
      <div>{{content.field_credits}}</div>
    </details>
    {% endif %}
  <div>


  {# <div class="citation">
    <h3>How to Cite This Source</h3>
    <span>"{{node.label}}," in in World History Commons, {{ url('<current>') }} [accessed {{ "now"|date("F j, Y") }}]</span>
  </div> #}

  <div class="tags">
    <h3>Tags</h3>
    {{content.field_region}}
    {{content.field_subject}}
    {{content.field_time_period}}
  </div>

</div>