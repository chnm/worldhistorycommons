<div class="directory search-results">
  <div class="content-header">
    <h1 class="content-header--label">Search Results</h1>
  </div>

  <div class="content-well">
    {% for item in items %}
      <div class="search-items">
        <div><strong>{{item.value['#result'].type}}</strong></div>
        <h2><a href="{{item.value['#result'].link}}">{{item.value['#result'].title}}</a></h2>
        <div>{{item.value['#result'].snippet['#markup']|raw}}</div>
      </div>
    {% endfor %}
  </div>
</div>