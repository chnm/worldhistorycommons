{{- /*
  Redirect manifest — the deterministic legacy->native bridge for the Caddy
  redirect pipeline (utils/redirect_mapper.py). Emitted at /redirects.json.

  worldhistorycommons preserved its clean Drupal slugs by pinning `url:` in
  front matter, so .RelPermalink already equals the original public URL.

  This manifest is the authoritative record of *what Hugo serves* (native paths
  + any `aliases:`). The /node/{id} legacy form is NOT derived here anymore — it
  is sourced from utils/node_redirects.tsv (the Drupal path_alias dump) and joined
  to these native paths by redirect_mapper. That keeps node ids out of the redirect
  path entirely; front-matter `drupal_node_id` remains only as the listing sort key.

  For every content page it records:
    native        the native Hugo URL (.RelPermalink) — the current public URL.
    legacy_paths  any old paths from `aliases:` (empty today; the seam for
                  future URL moves). Node ids are no longer included here.
    source_file   the content file path, for auditing.

  valid_targets lists the container pages (home/section/taxonomy/term) that the
  parent-section fallback may redirect unmatched URLs to.

  Output is deterministic: pages sorted by native path, targets sorted+uniq,
  no timestamps.
*/ -}}
{{- $regular := slice -}}
{{- range .Site.RegularPages -}}
  {{- $legacy := slice -}}
  {{- range .Aliases -}}{{ $legacy = $legacy | append . }}{{- end -}}
  {{- $src := "" -}}{{- with .File -}}{{ $src = .Path }}{{- end -}}
  {{- $regular = $regular | append (dict
        "native" .RelPermalink
        "legacy_paths" $legacy
        "source_file" $src) -}}
{{- end -}}
{{- $targets := slice -}}
{{- range .Site.Pages -}}
  {{- if in (slice "home" "section" "taxonomy" "term") .Kind -}}
    {{- $targets = $targets | append .RelPermalink -}}
  {{- end -}}
{{- end -}}
{{- dict
      "count" (len $regular)
      "pages" (sort $regular "native")
      "valid_targets" (sort (uniq $targets))
  | jsonify (dict "indent" "  ") -}}
